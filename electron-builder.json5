// @see https://www.electron.build/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "lua-checker.rsnl.gg",
  "productName": "Arsenal Lua Checker",
  "executableName": "arsenal-lua-checker",
  "artifactName": "arsenal-lua-checker-${version}.${ext}",
  "asar": true,
  "directories": {
    "output": "release",
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"],
      },
    ],
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"],
      },
    ],
    "category": "Utility",
  },
  "afterAllArtifactBuild": "build/postBuild.cjs",
}
